// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  userId          String    @unique // for display e.g. U-001
  email           String    @unique
  password        String
  name            String
  role            String // 'admin' or 'user'
  status          String   // e.g. "Verified", "Pending", "In Progress"
  username        String?
  phone           String?   @unique
  address         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organization    String?
  resetCode       String? // for password reset
  resetCodeExpiry DateTime? // for password reset
  otpCode         String? // for OTP verification
  otpExpiry       DateTime? // for OTP verification

  // Relations
  drones          Drone[]
  reports         Report[]
  alerts          Alert[]
}

model Drone {
  id        String   @id @default(uuid())
  name      String
  serial    String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  images    Image[]
  createdAt DateTime @default(now())
}

model Image {
  id        String   @id @default(uuid())
  url       String
  droneId   String
  drone     Drone    @relation(fields: [droneId], references: [id])
  createdAt DateTime @default(now())
}

model Weather {
  id          String   @id @default(uuid())
  date        DateTime
  temperature Float
  humidity    Float
  rainfall    Float
  location    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, location])
}


model DengueData {
  id        String   @id @default(uuid())
  location  String
  cases     Int
  date      DateTime
  createdAt DateTime @default(now())
}

model Alert {
  id        String   @id @default(uuid())
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  description String
  createdAt   DateTime @default(now())
}
